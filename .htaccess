RewriteOptions inherit

# =============================================================================
# CROSS-DOMAIN 301 REDIRECTS — sunconsultants.co.in → bis-certifications.com
# Source: Website Links - Sheet2.csv + legacy aliases
# -----------------------------------------------------------------------------
# Layer 1: THE_REQUEST — raw browser URL before LiteSpeed maps to .php
# Layer 2: REQUEST_URI — fallback for clean URLs / trailing slashes / .php
# Keep both layers BEFORE HTTPS enforcement and internal PHP rewrites.
# =============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ---------- Layer 1: THE_REQUEST priority ----------
    RewriteCond %{HTTP_HOST} ^(www\.)?sunconsultants\.co\.in$ [NC]
    RewriteCond %{THE_REQUEST} \s/+?(\?|\s) [NC]
    RewriteRule ^$ https://bis-certifications.com/ [R=301,L,NC]

    RewriteCond %{HTTP_HOST} ^(www\.)?sunconsultants\.co\.in$ [NC]
    RewriteCond %{THE_REQUEST} \s/+exhibitions-and-seminar(\.php)?(/|\s|\?) [NC]
    RewriteRule . https://bis-certifications.com/seminars-and-exhibitions [R=301,L,NC]

    RewriteCond %{HTTP_HOST} ^(www\.)?sunconsultants\.co\.in$ [NC]
