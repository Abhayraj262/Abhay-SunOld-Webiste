RewriteOptions inherit

# Legacy URLs → permanent redirects (301 passes equity; 302 did not)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^bis-licence-consultants/?$ /bis-registration-certification [R=301,L]
    RewriteRule ^lmpc-certification/?$ /lmpc-certification-consultants [R=301,L]
    RewriteRule ^cdsco/?$ /cdsco-registration-certification [R=301,L]
    RewriteRule ^bis-certification/?$ /bis-registration-certification [R=301,L]
    RewriteRule ^peso-certification/?$ /peso-certification-consultants [R=301,L]
    RewriteRule ^bis-\(crs\)-registration-for-elect/?$ /bis-crs-registration-for-electronic [R=301,L]
    RewriteRule ^impc-certification-consultants/?$ /lmpc-certification-consultants [R=301,L]
</IfModule>

# HTTPS + non-www (must not depend on mod_expires)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# Clean URL rewrite rules (works on both localhost and production)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Remove .php extension from URLs
    RewriteCond %{THE_REQUEST} /([^.]+)\.php [NC]
    RewriteRule ^ /%1 [NC,L,R=301]
    
    # Notifications path
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^notifications/([A-Za-z0-9-]+)/?$ notifications.php?path=$1 [NC,L,QSA]

    # Canonical SEO path → existing implementation (ERDA page meta uses /erda-certificate-india)
    RewriteRule ^apeda-registration-india/?$ APEDARegistration.php [NC,L]
    RewriteRule ^tac-certificate-india/?$ TACCertificate.php [NC,L]
    RewriteRule ^erda-certificate-india/?$ ERDAandERDACertificate.php [NC,L]
    RewriteRule ^saso-saber-certification/?$ SASOCertificate.php [NC,L]

    # Serve .php files without the .php extension
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*?)/?$ $1.php [NC,L]

    # Remove index.php from URLs
    RewriteCond %{THE_REQUEST} ^.*/index\.php 
    RewriteRule ^(.*)index.php$ /$1 [R=301,L]

</IfModule>

# Custom 404 error page
ErrorDocument 404 /404.php

RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^sunconsultants\.co\.in$ [OR]
RewriteCond %{HTTP_HOST} ^www\.sunconsultants\.co\.in$
RewriteRule ^/?$ "https\:\/\/sunconsultants\.co\.in\/" [R=301,L]
