# =============================================================================
# HTTPS + non-www enforcement
# =============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# =============================================================================
# Internal clean-URL rewrites (NOT on sunconsultants.co.in)
# =============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP_HOST} !^(www\.)?sunconsultants\.co\.in$ [NC]
    RewriteCond %{THE_REQUEST} /([^.]+)\.php [NC]
    RewriteRule ^ /%1 [NC,L,R=301]

    RewriteCond %{HTTP_HOST} !^(www\.)?sunconsultants\.co\.in$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^notifications/([A-Za-z0-9-]+)/?$ notifications.php?path=$1 [NC,L,QSA]

    RewriteCond %{HTTP_HOST} !^(www\.)?sunconsultants\.co\.in$ [NC]
    RewriteRule ^apeda-registration-india/?$ APEDARegistration.php [NC,L]
    RewriteCond %{HTTP_HOST} !^(www\.)?sunconsultants\.co\.in$ [NC]
    RewriteRule ^tac-certificate-india/?$ TACCertificate.php [NC,L]
    RewriteCond %{HTTP_HOST} !^(www\.)?sunconsultants\.co\.in$ [NC]
    RewriteRule ^erda-certificate-india/?$ ERDAandERDACertificate.php [NC,L]
    RewriteCond %{HTTP_HOST} !^(www\.)?sunconsultants\.co\.in$ [NC]
    RewriteRule ^saso-saber-certification/?$ SASOCertificate.php [NC,L]

    RewriteCond %{HTTP_HOST} !^(www\.)?sunconsultants\.co\.in$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*?)/?$ $1.php [NC,L]

    RewriteCond %{THE_REQUEST} ^.*/index\.php
    RewriteRule ^(.*)index.php$ /$1 [R=301,L]
</IfModule>

# PHP 301 fallback when LiteSpeed executes existing .php before mod_rewrite
<IfModule mod_php.c>
    php_value auto_prepend_file include/sunconsultants-bis-redirects.php
</IfModule>
<IfModule lsapi_module>
    php_value auto_prepend_file include/sunconsultants-bis-redirects.php
</IfModule>

# Custom 404 error page
ErrorDocument 404 /404.php
